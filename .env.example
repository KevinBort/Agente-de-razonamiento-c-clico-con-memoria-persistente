# Copiá este archivo a ".env" y completá tus claves reales.
# NUNCA subas el archivo ".env" a GitHub (ya está en .gitignore).

# Proveedor del LLM: "openai" o "anthropic"
LLM_PROVIDER="openai"
OPENAI_API_KEY="api key xx"
ANTHROPIC_API_KEY="api key xx"

# Opcional: si lo omitís se usa el modelo por defecto del proveedor
LLM_MODEL=""

# Opcional
RECURSION_LIMIT="10"
DB_PATH="data/checkpoints.sqlite"
